# Supabase (무료 티어)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# 위 두 값과 동일한 URL/anon key를 브라우저(클라이언트 컴포넌트)에도 노출해야 해서
# NEXT_PUBLIC_ 접두사 버전도 별도로 둔다 (Phase 4 카카오 로그인, @supabase/ssr).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 카카오 로그인 (OIDC + signInWithIdToken 직접 구현 — CLAUDE.md "로그인 구현 방식 변경 이력" 참고)
# REST API 키/redirect_uri는 브라우저에서 인가 URL을 직접 만들어야 해서 NEXT_PUBLIC_로 노출한다.
NEXT_PUBLIC_KAKAO_REST_API_KEY=
NEXT_PUBLIC_KAKAO_REDIRECT_URI=
# Client Secret은 토큰 교환(서버)에서만 쓰므로 절대 NEXT_PUBLIC_로 노출하지 않는다.
KAKAO_CLIENT_SECRET=

# Google Gemini Flash (AI Studio, 무료 티어: RPM 15 / RPD 1500)
GEMINI_API_KEY=

# Vercel Cron 인증용 시크릿 (app/api/cron/* 보호)
CRON_SECRET=

# 카카오 오픈빌더 스킬의 "헤더값" 설정에 동일한 값을 넣어 웹훅 출처를 검증 (app/api/kakao-webhook 보호)
KAKAO_SKILL_SECRET=
